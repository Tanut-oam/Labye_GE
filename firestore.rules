rules_version = '2';

// กฎความปลอดภัยของ Cloud Firestore
//
// หลักการ
//   - ต้องเข้าสู่ระบบก่อนถึงจะอ่านหรือเขียนอะไรได้
//   - ทุกคนอ่านโพสต์และคอมเมนต์ได้ แต่แก้หรือลบได้เฉพาะของตัวเอง
//   - คะแนนความเครียดและแบบประเมิน เจ้าของเท่านั้นที่อ่านของตัวเองได้
//     ผู้ใช้คนอื่นอ่านไม่ได้เลย เพราะเป็นข้อมูลอ่อนไหว
//
// การวิเคราะห์ผลวิจัยให้ดึงข้อมูลจากหน้า Firebase Console หรือ Admin SDK
// ไม่ใช่เปิดสิทธิ์อ่านให้ทุกคนในกฎนี้

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ข้อมูลคณะและชั้นปี เจ้าของเท่านั้นที่เข้าถึงได้
    match /profiles/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /posts/{postId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 10
        && request.resource.data.body.size() <= 500
        && request.resource.data.hidden == false
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0;

      // เจ้าของแก้หรือลบโพสต์ตัวเองได้
      // ส่วนคนอื่นแก้ได้เฉพาะตัวนับ like กับ comment เท่านั้น
      allow update: if isOwner(resource.data.uid)
        || (signedIn() && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['likeCount', 'commentCount']));

      allow delete: if isOwner(resource.data.uid);

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.body.size() >= 10
          && request.resource.data.body.size() <= 300;
        allow update, delete: if isOwner(resource.data.uid);
      }
    }

    // รหัสเอกสารคือ postId_uid จึงกดใจซ้ำไม่ได้โดยธรรมชาติ
    match /likes/{likeId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && likeId == request.resource.data.postId + '_' + request.auth.uid;
      allow delete: if isOwner(resource.data.uid);
    }

    // คะแนนความเครียด เขียนได้อย่างเดียว แก้ย้อนหลังไม่ได้
    match /stressTests/{id} {
      allow read: if isOwner(resource.data.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.phase in ['pre', 'post'];
      allow update, delete: if false;
    }

    match /satisfaction/{id} {
      allow read: if isOwner(resource.data.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
